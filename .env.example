# Copy to .env (git-ignored). Never commit a filled-in copy. Scripts read these and never print them.

# The Claude API key, from the Claude Console workspace gtm-pipeline (US$10 monthly limit).
# Copied from the pipeline's .env by the one command in docs/build-guide.md, step 1.
ANTHROPIC_API_KEY=

# The local n8n's API key, used only to publish and check this build's workflows (scripts/n8n_publish.py).
# Copied by the same command.
N8N_API_KEY=

# Made by scripts/setup_db.py: the password of the changedesk_app login. Pasted by Israel into the
# n8n Postgres credential "Change Desk (Postgres)".
CHANGEDESK_DB_PASSWORD=

# Optional. Defaults: the local Supabase stack.
# SUPABASE_DB_CONTAINER=supabase_db_hubspot-ai-database
# CHANGEDESK_DB_HOST=127.0.0.1
# CHANGEDESK_DB_PORT=54322
# N8N_BASE_URL=http://localhost:5678
